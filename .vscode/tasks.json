{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dev Tools",
      "type": "shell",
      "command": "python -m pip install -r requirements-dev.txt"
    },
    {
      "label": "Format Code",
      "type": "shell",
      "command": "python -m ruff format . && python -m isort ."
    },
    {
      "label": "Lint Code",
      "type": "shell",
      "command": "python -m ruff check .",
      "problemMatcher": []
    },
    {
      "label": "Lint and Auto-fix",
      "type": "shell",
      "command": "python -m ruff check . --fix"
    },
    {
      "label": "Enable Pre-commit",
      "type": "shell",
      "command": "python -m pre_commit install"
    },
    {
      "label": "Run Full Quality Check",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Install Dev Tools",
        "Format Code",
        "Lint and Auto-fix",
        "Lint Code",
        "Enable Pre-commit"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}